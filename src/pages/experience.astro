---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';

const experience = (await getEntry('experience', 'experience'))?.data;
---

<Base title="経歴" description="学歴と職歴・活動の歩み。">
  <div class="container">
    <PageHeader eyebrow="Experience" title="経歴" />
    {experience && experience.education.length > 0 && <Timeline heading="学歴" items={experience.education} />}
    {experience && experience.work.length > 0 && <Timeline heading="職歴・活動" items={experience.work} />}
  </div>
</Base>
