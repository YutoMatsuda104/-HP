---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatYm } from '../lib';

const skills = (await getEntry('skills', 'skills'))?.data;
const certs = skills?.certifications ?? [];
const groups = skills?.groups ?? [];
---

<Base title="スキル" description="取得した資格と、専門分野・技術。">
  <PageHeader eyebrow="Skills" title="スキル" lead="取得した資格と、これまでの学びと実務で身につけてきた分野です。" />
  <div class="container">
    {
      certs.length > 0 && (
        <section class="block" aria-labelledby="certs-title">
          <div class="block-head">
            <p class="eyebrow">Certifications</p>
            <h2 id="certs-title">資格</h2>
          </div>
          <ul class="certs">
            {certs.map((c) => (
              <li class="cert reveal">
                {c.date && <span class="cert-date">{formatYm(c.date)}</span>}
                <span class="cert-name">{c.name}</span>
                {c.description && <p class="desc">{c.description}</p>}
                {(c.reason || c.goal) && (
                  <dl class="why">
                    {c.reason && (
                      <div>
                        <dt>取得した理由</dt>
                        <dd>{c.reason}</dd>
                      </div>
                    )}
                    {c.goal && (
                      <div>
                        <dt>活かしたいこと</dt>
                        <dd>{c.goal}</dd>
                      </div>
                    )}
                  </dl>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      groups.length > 0 && (
        <section class="block" aria-labelledby="skills-title">
          <div class="block-head">
            <p class="eyebrow">Skills</p>
            <h2 id="skills-title">スキル</h2>
          </div>
          <dl class="skills">
            {groups.map((g, i) => (
              <div class="row reveal">
                <dt>
                  <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  {g.name}
                </dt>
                <dd>
                  {g.description && <p class="desc">{g.description}</p>}
                  <ul class="chips">
                    {g.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  {g.note && <p class="muted note">{g.note}</p>}
                  {(g.reason || g.goal) && (
                    <dl class="why">
                      {g.reason && (
                        <div>
                          <dt>身につけた理由</dt>
                          <dd>{g.reason}</dd>
                        </div>
                      )}
                      {g.goal && (
                        <div>
                          <dt>活かしたいこと</dt>
                          <dd>{g.goal}</dd>
                        </div>
                      )}
                    </dl>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </div>
</Base>

<style>
  .block + .block {
    margin-top: 72px;
  }

  .block-head {
    display: grid;
    gap: 4px;
    margin-bottom: 24px;
  }

  .block-head h2 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    font-weight: var(--weight-heading);
  }

  /* 資格: 取得年月と名前を大きく並べる */
  .certs {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }

  .cert {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 22px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--accent);
    border-radius: var(--rounded-md);
  }

  .cert-date {
    font-family: var(--font-num);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .cert-name {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .desc {
    font-size: 0.9375rem;
    line-height: 1.8;
    margin-bottom: 4px;
  }

  .why {
    margin: 10px 0 0;
    display: grid;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
  }

  .why dt {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .why dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--muted);
  }

  /* スキル: 分野ごとに1行ずつ */
  .skills {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .row {
    display: grid;
    gap: 10px;
    padding: 20px 22px;
  }

  .row + .row {
    border-top: 1px solid var(--line);
  }

  .row > dt {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-weight: var(--weight-heading);
    font-size: 1.0625rem;
  }

  .num {
    font-family: var(--font-num);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-2);
  }

  .row > dd {
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: 4px 14px;
    border-radius: var(--rounded-sm);
    background: var(--accent-soft);
    color: var(--text);
  }

  .note {
    margin-top: 8px;
    font-size: 0.875rem;
  }

  @media (min-width: 720px) {
    .row {
      grid-template-columns: 13rem 1fr;
      align-items: start;
      gap: 24px;
      padding: 22px 28px;
    }

    .row > dt {
      padding-top: 4px;
    }
  }
</style>
