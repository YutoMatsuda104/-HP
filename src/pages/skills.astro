---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatYm } from '../lib';

const skills = (await getEntry('skills', 'skills'))?.data;
---

<Base title="スキル" description="専門分野、技術、資格。">
  <PageHeader eyebrow="Skills" title="スキル" lead="これまでの学びと実務で身につけてきた分野と、取得した資格です。" />
  <div class="container">
    <div class="grid">
      {
        skills?.groups.map((g, i) => (
          <section class="panel reveal" aria-labelledby={`skill-${i}`}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h2 id={`skill-${i}`} class="panel-title">{g.name}</h2>
            <ul class="chips">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {g.note && <p class="muted note">{g.note}</p>}
          </section>
        ))
      }
      {
        skills && skills.certifications.length > 0 && (
          <section class="panel cert reveal" aria-labelledby="certs-title">
            <span class="num" aria-hidden="true">{String(skills.groups.length + 1).padStart(2, '0')}</span>
            <h2 id="certs-title" class="panel-title">資格</h2>
            <ul class="cert-list">
              {skills.certifications.map((c) => (
                <li>
                  <span>{c.name}</span>
                  {c.date && <span class="cert-date">{formatYm(c.date)}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .num {
    font-family: var(--font-num);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-2);
  }

  .panel-title {
    font-size: 1.25rem;
    font-weight: 800;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    font-size: 0.875rem;
    line-height: 1.6;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text);
  }

  .cert-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 6px;
    font-size: 0.9375rem;
    line-height: 1.6;
    border-bottom: 1px dashed var(--line);
  }

  .cert-list li:last-child {
    border-bottom: 0;
  }

  .cert-date {
    font-family: var(--font-num);
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
