---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getProfile, obfuscateEmail } from '../lib';

const profile = await getProfile();
const shortUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
---

<Base title="連絡先" description={`${profile.name}への連絡先です。`}>
  <PageHeader eyebrow="Contact" title="連絡先" lead="ご連絡は、以下のメールアドレスまでお願いいたします。" />
  <div class="container">
    <dl class="contact">
      {
        profile.email && (
          <div>
            <dt>メール</dt>
            <dd>
              <span class="email-row">
                <span class="email" id="email">{obfuscateEmail(profile.email)}</span>
                <button type="button" class="copy" id="copy-email" hidden>コピー</button>
              </span>
              <p class="note">迷惑メール対策のため「@」を「[at]」と表記しています。送信の際は [at] を @ に変えてください。「コピー」を押すと、@ に直した状態でコピーできます。</p>
            </dd>
          </div>
        )
      }
      {
        profile.github && (
          <div>
            <dt>GitHub</dt>
            <dd>
              <a href={profile.github}>{shortUrl(profile.github)}</a>
            </dd>
          </div>
        )
      }
      {
        profile.wantedly && (
          <div>
            <dt>Wantedly</dt>
            <dd>
              <a href={profile.wantedly}>{shortUrl(profile.wantedly)}</a>
            </dd>
          </div>
        )
      }
    </dl>
  </div>
</Base>

<script>
  // ページには [at] 表記だけを置き、押されたときに @ に直してコピーする
  const button = document.getElementById('copy-email');
  const email = document.getElementById('email');
  if (button && email && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText((email.textContent ?? '').replace('[at]', '@').trim());
        button.textContent = 'コピーしました';
      } catch {
        button.textContent = 'コピーできませんでした';
      }
      setTimeout(() => (button.textContent = 'コピー'), 2000);
    });
  }
</script>

<style>
  .contact {
    margin: 0;
    border-top: 1px solid var(--line);
    max-width: var(--measure);
  }

  .contact > div {
    display: grid;
    gap: 4px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }

  .contact dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .contact dd {
    margin: 0;
    word-break: break-all;
  }

  .email {
    font-size: clamp(1.125rem, 1rem + 1vw, 1.5rem);
    font-weight: 600;
    font-family: var(--font-num);
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }

  .copy {
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 4px 12px;
    border: 1px solid var(--accent);
    border-radius: var(--rounded-sm);
    background: var(--surface);
    color: var(--accent);
    cursor: pointer;
  }

  .copy:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .note {
    margin-top: 8px;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--muted);
    word-break: normal;
  }

  @media (min-width: 640px) {
    .contact > div {
      grid-template-columns: 8rem 1fr;
      align-items: baseline;
      gap: 24px;
    }
  }
</style>
