---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProfile, getProjects } from '../lib';
import { pages } from '../nav';

const profile = await getProfile();
const recent = (await getProjects()).slice(0, 3);
const initial = (profile.nameEn ?? profile.name).trim().charAt(0);
---

<Base>
  <section class="hero" aria-labelledby="hero-name">
    <div class="container hero-inner">
      <div class="hero-photo fade-in">
        {
          profile.photo ? (
            <Picture
              src={profile.photo}
              alt={profile.photoAlt ?? profile.name}
              widths={[400, 640, 960]}
              sizes="(min-width: 900px) 420px, (min-width: 640px) 60vw, 100vw"
              formats={['avif', 'webp']}
              width={960}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div class="monogram" aria-hidden="true">{initial}</div>
          )
        }
      </div>
      <div class="hero-text fade-in">
        {profile.nameEn && <p class="name-en">{profile.nameEn}</p>}
        <h1 id="hero-name" class="name">
          {profile.name}
          {profile.nameReading && <span class="visually-hidden">({profile.nameReading})</span>}
        </h1>
        {profile.affiliation && <p class="affiliation">{profile.affiliation}</p>}
        {profile.lead && <p class="lead">{profile.lead}</p>}
      </div>
    </div>
  </section>

  {
    profile.intro && (
      <section class="block" aria-labelledby="profile-title">
        <div class="container">
          <h2 id="profile-title" class="block-title">プロフィール</h2>
          <p class="intro">{profile.intro}</p>
          <p class="more">
            <a href="/about/">自己紹介を読む →</a>
          </p>
        </div>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="block" aria-labelledby="recent-title">
        <div class="container">
          <div class="block-head">
            <h2 id="recent-title" class="block-title">最近の研究・活動</h2>
            <a href="/projects/">すべて見る →</a>
          </div>
          <div class="project-grid">
            {recent.map((p) => (
              <ProjectCard project={p} headingLevel={3} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="block" aria-labelledby="contents-title">
    <div class="container">
      <h2 id="contents-title" class="block-title">コンテンツ</h2>
      <ul class="directory">
        {
          pages.map((p) => (
            <li>
              <a href={p.href}>
                <span class="dir-label">{p.label}</span>
                <span class="dir-desc">{p.description}</span>
                <span class="dir-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 32px 56px;
  }

  .hero-inner {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .hero-photo :global(img),
  .monogram {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 60% 30%;
    border-radius: 20px;
    background: var(--line);
  }

  .monogram {
    display: grid;
    place-items: center;
    font-size: 5rem;
    font-weight: 700;
    color: var(--muted);
  }

  .name-en {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .name {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-top: 4px;
  }

  .affiliation {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .lead {
    margin-top: 24px;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 500;
    line-height: 1.8;
  }

  @media (min-width: 640px) {
    .hero-photo {
      max-width: 520px;
    }
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: 72px 88px;
    }

    .hero-inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }

    .hero-text {
      order: -1;
    }

    .hero-photo :global(img),
    .monogram {
      aspect-ratio: 4 / 5;
    }
  }

  .block {
    padding-block: 56px;
    border-top: 1px solid var(--line);
  }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
  }

  .block-head .block-title {
    margin-bottom: 0;
  }

  .block-head a,
  .more a {
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .block-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .intro {
    max-width: var(--measure);
  }

  .more {
    margin-top: 20px;
  }

  .project-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  .directory {
    border-top: 1px solid var(--line);
  }

  .directory a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2px 16px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }

  .directory a:hover .dir-label,
  .directory a:hover .dir-arrow {
    color: var(--accent);
  }

  .dir-label {
    font-weight: 700;
  }

  .dir-desc {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .dir-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .directory a {
      grid-template-columns: 10rem 1fr auto;
    }

    .dir-desc {
      grid-column: 2;
    }

    .dir-arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
