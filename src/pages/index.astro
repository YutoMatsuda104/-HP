---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationList from '../components/PublicationList.astro';
import { getProfile, getProjects, hasDetail } from '../lib';
import { pages } from '../nav';

const profile = await getProfile();
const projects = await getProjects();

const featured = projects.find((p) => p.data.featured) ?? projects.find((p) => p.data.kind === 'research');
const papers = projects.filter((p) => p.data.kind === 'paper');
const otherResearch = projects.filter((p) => p.data.kind === 'research' && p !== featured);
const activities = projects.filter((p) => p.data.kind === 'activity' && p !== featured);


const initial = (profile.nameEn ?? profile.name).trim().charAt(0);
---

<Base>
  <!-- ヒーロー -->
  <section class="hero dots" aria-labelledby="hero-name">
    <div class="container hero-inner">
      <div class="hero-text fade-in">
        {profile.nameEn && <p class="eyebrow">{profile.nameEn}</p>}
        <h1 id="hero-name" class="name">
          {profile.name}
          {profile.nameReading && <span class="visually-hidden">({profile.nameReading})</span>}
        </h1>
        {profile.lead && <p class="lead"><span>{profile.lead}</span></p>}
        {
          profile.now.length > 0 && (
            <div class="now">
              <p class="now-label">Now</p>
              <ul>
                {profile.now.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            </div>
          )
        }
        <p class="cta">
          <a class="btn primary" href="/about/">自己紹介を読む</a>
          <a class="btn" href="/projects/">研究・活動を見る</a>
        </p>
      </div>
      <div class="hero-visual fade-in delay">
        <div class="photo-frame">
          {
            profile.photo ? (
              <Picture
                src={profile.photo}
                alt={profile.photoAlt ?? profile.name}
                widths={[400, 640, 960]}
                sizes="(min-width: 960px) 460px, 92vw"
                formats={['avif', 'webp']}
                width={960}
                loading="eager"
                fetchpriority="high"
              />
            ) : (
              <div class="monogram" aria-hidden="true">{initial}</div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 注目の研究 -->
  {
    featured && (
      <section class="block" aria-labelledby="research-title">
        <div class="container">
          <p class="eyebrow">Research</p>
          <h2 id="research-title" class="block-title">研究</h2>
          <article class="feature reveal">
            {featured.data.cover && (
              <div class="feature-img">
                <Image
                  src={featured.data.cover}
                  alt={featured.data.coverAlt ?? ''}
                  widths={[600, 1000]}
                  sizes="(min-width: 960px) 560px, 100vw"
                />
              </div>
            )}
            <div class="feature-body">
              {featured.data.result && <p class="badge">{featured.data.result}</p>}
              <h3 class="feature-title">{featured.data.title}</h3>
              {featured.data.summary && <p class="feature-summary">{featured.data.summary}</p>}
              {hasDetail(featured) && (
                <a class="arrow-link" href={`/projects/${featured.id}/`}>
                  研究の詳細を見る
                </a>
              )}
            </div>
          </article>
          {otherResearch.length > 0 && (
            <div class="grid more-research">
              {otherResearch.slice(0, 3).map((p) => (
                <ProjectCard project={p} headingLevel={3} />
              ))}
            </div>
          )}
          <p class="block-more">
            <a class="arrow-link" href="/projects/">
              研究をすべて見る
            </a>
          </p>
        </div>
      </section>
    )
  }

  <!-- 論文 -->
  {
    papers.length > 0 && (
      <section class="block" aria-labelledby="pubs-title">
        <div class="container">
          <p class="eyebrow">Publications</p>
          <h2 id="pubs-title" class="block-title">論文・発表</h2>
          <PublicationList papers={papers} self={profile.name} />
        </div>
      </section>
    )
  }

  <!-- 活動・受賞 -->
  {
    activities.length > 0 && (
      <section class="block" aria-labelledby="act-title">
        <div class="container">
          <div class="block-head">
            <div>
              <p class="eyebrow">Activities</p>
              <h2 id="act-title" class="block-title">その他の活動</h2>
            </div>
            <a class="arrow-link" href="/projects/">
              すべて見る
            </a>
          </div>
          <div class="grid">
            {activities.slice(0, 3).map((p) => (
              <ProjectCard project={p} headingLevel={3} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 各ページへの案内 -->
  <section class="block" aria-labelledby="explore-title">
    <div class="container">
      <p class="eyebrow">Explore</p>
      <h2 id="explore-title" class="block-title">もっと知る</h2>
      <ul class="explore">
        {
          pages.map((p, i) => (
            <li>
              <a href={p.href}>
                <span class="ex-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="ex-en">{p.en}</span>
                <span class="ex-label">{p.label}</span>
                <span class="ex-desc">{p.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ── ヒーロー ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 40px 72px;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .name {
    margin-top: 14px;
    font-size: clamp(2.75rem, 1.8rem + 4.5vw, 5rem);
    font-weight: var(--weight-heading);
    letter-spacing: 0.06em;
    line-height: 1.15;
  }

  .lead {
    margin-top: 20px;
    font-size: clamp(1.125rem, 1rem + 0.7vw, 1.5rem);
    font-weight: 700;
    line-height: 1.7;
  }

  .lead {
    padding-left: 16px;
    border-left: 2px solid var(--accent);
  }

  .now {
    margin-top: 32px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--rounded-sm);
  }

  .now-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-num);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .now-label::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .now li {
    position: relative;
    padding-left: 16px;
    font-size: 0.9375rem;
    line-height: 1.9;
  }

  .now li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 6px;
    height: 2px;
    background: var(--accent);
  }

  .cta {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: var(--rounded-sm);
    border: 1px solid var(--text);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .btn.primary:hover {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .hero-visual {
    position: relative;
    max-width: 480px;
    width: 100%;
    justify-self: center;
  }

  .photo-frame {
    position: relative;
  }

  .photo-frame::before {
    content: '';
    position: absolute;
    inset: 14px -14px -14px 14px;
    border: 1px solid var(--text);
    z-index: -1;
  }

  .photo-frame :global(img),
  .monogram {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 60% 30%;
    border-radius: var(--rounded-sm);
    background: var(--line);
  }

  .monogram {
    display: grid;
    place-items: center;
    font-size: 5rem;
    font-weight: var(--weight-heading);
    color: var(--muted);
  }

  @media (max-width: 959px) {
    .photo-frame::before {
      inset: 10px -10px -10px 10px;
    }

    .hero-visual {
      order: -1;
      max-width: 420px;
    }

    .photo-frame :global(img),
    .monogram {
      aspect-ratio: 1 / 1;
    }
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: 88px 112px;
    }

    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 72px;
    }
  }

  /* ── セクション共通 ── */
  .block {
    padding-block: 80px;
  }

  .block + .block {
    border-top: 1px solid var(--line);
  }

  .block-title {
    margin-top: 10px;
    margin-bottom: 36px;
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.25rem);
    font-weight: var(--weight-heading);
  }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 36px;
  }

  .block-head .block-title {
    margin-bottom: 0;
  }

  .block-head .arrow-link {
    font-size: 0.9375rem;
  }

  /* ── 注目の研究 ── */
  .feature {
    display: grid;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--rounded-sm);
    overflow: hidden;
  }

  .feature-img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .feature-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 28px;
  }

  .feature-title {
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.625rem);
    font-weight: var(--weight-heading);
    line-height: 1.55;
  }

  .feature-summary {
    color: var(--muted);
  }

  .feature-body .arrow-link {
    margin-top: 6px;
  }

  @media (min-width: 960px) {
    .feature {
      grid-template-columns: 1.1fr 1fr;
    }

    .feature-img {
      aspect-ratio: auto;
      min-height: 100%;
    }

    .feature-body {
      padding: 48px;
      justify-content: center;
    }
  }

  .more-research {
    margin-top: 22px;
  }

  .block-more {
    margin-top: 28px;
    text-align: right;
  }

  /* ── 活動 ── */
  .grid {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }

  /* ── もっと知る ── */
  .explore {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
  }

  @media (min-width: 1000px) {
    .explore {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .explore a {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 168px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .explore a:hover {
    background: var(--ink);
    color: var(--ink-text);
  }

  .ex-num {
    font-family: var(--font-num);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-2);
  }

  .ex-en {
    position: absolute;
    right: 14px;
    top: 14px;
    font-family: var(--font-num);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .ex-label {
    margin-top: auto;
    font-size: 1.125rem;
    font-weight: var(--weight-heading);
  }

  .ex-desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    opacity: 0.7;
  }
</style>
