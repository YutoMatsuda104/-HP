---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="page-header dots">
  <div class="container inner fade-in">
    <span class="watermark" aria-hidden="true">{eyebrow}</span>
    <span class="eyebrow" aria-hidden="true">{eyebrow}</span>
    <h1 class="page-title">{title}</h1>
    {lead && <p class="page-lead">{lead}</p>}
  </div>
</header>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    border-bottom: 3px double var(--text);
    margin-bottom: 56px;
  }

  .inner {
    position: relative;
    padding-block: 64px 48px;
  }

  .watermark {
    position: absolute;
    right: 20px;
    bottom: -0.22em;
    font-family: var(--font-num);
    font-size: clamp(4rem, 2rem + 10vw, 10rem);
    font-weight: var(--weight-heading);
    letter-spacing: -0.02em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--muted) 30%, transparent);
    text-transform: uppercase;
    pointer-events: none;
    user-select: none;
  }

  .page-title {
    margin-top: 12px;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-weight: var(--weight-heading);
  }

  .page-lead {
    margin-top: 16px;
    color: var(--muted);
    max-width: var(--measure);
  }

  @media (min-width: 768px) {
    .inner {
      padding-block: 96px 64px;
    }
  }
</style>
