---
import type { CollectionEntry } from 'astro:content';
import { formatYm, hasDetail } from '../lib';

interface Props {
  papers: CollectionEntry<'projects'>[];
  /** 著者名のうち太字にする名前(本人) */
  self: string;
  headingLevel?: 2 | 3;
}
const { papers, self, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const selfKey = self.replace(/\s+/g, '');
---

<ol class="pubs">
  {
    papers.map((p, i) => {
      const d = p.data;
      const authors = d.authors?.split(/[,、]\s*/) ?? [];
      return (
        <li class="pub reveal">
          <span class="num" aria-hidden="true">{String(papers.length - i).padStart(2, '0')}</span>
          <div class="body">
            <p class="year">{formatYm(d.start)}</p>
            <Heading class="title">
              {hasDetail(p) ? <a href={`/projects/${p.id}/`}>{d.title}</a> : d.title}
            </Heading>
            {authors.length > 0 && (
              <p class="authors">
                {authors.map((a, j) => (
                  <>
                    {a.replace(/\s+/g, '') === selfKey ? <strong>{a}</strong> : a}
                    {j < authors.length - 1 && ', '}
                  </>
                ))}
              </p>
            )}
            {d.venue && <p class="venue">{d.venue}</p>}
            {d.summary && <p class="summary">{d.summary}</p>}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .pubs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .pub {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }

  .num {
    font-family: var(--font-num);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--accent);
    padding-top: 4px;
  }

  .year {
    font-family: var(--font-num);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.6;
    margin-top: 2px;
  }

  .title a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s var(--ease);
  }

  .title a:hover {
    background-size: 100% 1px;
  }

  .authors {
    margin-top: 6px;
    font-size: 0.9375rem;
  }

  .venue {
    font-size: 0.875rem;
    color: var(--muted);
    font-style: italic;
  }

  .summary {
    margin-top: 10px;
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: var(--measure);
  }

  @media (min-width: 768px) {
    .pub {
      gap: 32px;
    }

    .num {
      font-size: 2.75rem;
      width: 3.5rem;
    }
  }
</style>
