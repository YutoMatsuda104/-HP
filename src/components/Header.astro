---
import { pages } from '../nav';

interface Props {
  brand: string;
}
const { brand } = Astro.props;
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(href);
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href="/" aria-current={current === '/' ? 'page' : undefined}>{brand}</a>
    <nav aria-label="メインナビゲーション">
      <ul>
        {
          pages.map((p) => (
            <li>
              <a href={p.href} aria-current={isCurrent(p.href) ? 'page' : undefined}>
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  nav {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  nav ul {
    display: flex;
    gap: 2px;
  }

  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: var(--rounded-sm);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    background: var(--accent-soft);
  }

  /* スマートフォンでは名前とメニューを2段にする */
  @media (max-width: 720px) {
    .inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 10px;
    }

    nav {
      margin-inline: -12px;
      padding-bottom: 6px;
    }

    nav a {
      padding: 6px 12px;
      font-size: 0.8125rem;
    }
  }
</style>
