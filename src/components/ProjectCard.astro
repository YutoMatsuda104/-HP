---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatPeriod, hasDetail } from '../lib';

interface Props {
  project: CollectionEntry<'projects'>;
  /** 見出しのレベル(ページ内の構造に合わせる) */
  headingLevel?: 2 | 3;
}
const { project, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const d = project.data;
const detail = hasDetail(project);
const period = formatPeriod(d.start, d.end);
const meta = [d.category, period].filter(Boolean).join(' ・ ');
---

<article class:list={['card', 'reveal', { linked: detail }]}>
  {
    d.cover && (
      <Image
        class="cover"
        src={d.cover}
        alt={d.coverAlt ?? ''}
        widths={[400, 800]}
        sizes="(min-width: 768px) 480px, 100vw"
      />
    )
  }
  <div class="content">
    {meta && <p class="meta">{meta}</p>}
    <Heading class="title">
      {detail ? <a href={`/projects/${project.id}/`}>{d.title}</a> : d.title}
    </Heading>
    {d.result && <p class="result">{d.result}</p>}
    {(d.venue || d.role) && <p class="role">{[d.venue, d.role].filter(Boolean).join(' ・ ')}</p>}
    {d.summary && <p class="summary">{d.summary}</p>}
    {
      d.tech.length > 0 && (
        <ul class="tags" aria-label="使用した技術・手法">
          {d.tech.map((t) => <li>{t}</li>)}
        </ul>
      )
    }
    {detail && <p class="more" aria-hidden="true">詳しく見る →</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .linked:hover {
    border-color: var(--accent);
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    flex: 1;
  }

  .meta {
    font-size: 0.8125rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  /* カード全体をクリックできるようにする */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .title a:focus-visible {
    outline: none;
  }

  .title a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .result {
    align-self: flex-start;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 10px;
    border-radius: 999px;
  }

  .role {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .summary {
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: 4px;
  }

  .tags li::before {
    content: '#';
    opacity: 0.6;
    margin-right: 1px;
  }

  .more {
    margin-top: auto;
    padding-top: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
