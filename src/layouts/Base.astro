---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { getProfile, obfuscateEmail } from '../lib';
import { pages } from '../nav';
import tokens from '../styles/tokens.json';

interface Props {
  /** ページ固有のタイトル(トップページでは省略) */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const profile = await getProfile();
const { title, description = profile.siteDescription, type = 'website' } = Astro.props;

const siteName = profile.nameEn ? `${profile.name} | ${profile.nameEn}` : profile.name;
const pageTitle = title ? `${title} | ${profile.name}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const isHome = Astro.url.pathname === '/';
const introName = [...(profile.nameEn ?? profile.name)];

const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name.replace(/\s+/g, ''),
      alternateName: profile.nameEn,
      url: Astro.site?.href,
      description: profile.siteDescription,
      affiliation: profile.affiliation,
    }
  : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content={tokens.colors.neutral} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={tokens.colors['neutral-dark']} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline>
      // 開いたときの演出は、同じタブで最初の1回だけ表示する
      try {
        if (sessionStorage.getItem('intro-seen')) document.documentElement.classList.add('intro-seen');
        else sessionStorage.setItem('intro-seen', '1');
      } catch (e) {}
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="intro" aria-hidden="true">
      <p class="intro-name">
        {introName.map((ch, i) => <span style={`--i:${i}`}>{ch === ' ' ? '\u00a0' : ch}</span>)}
      </p>
      <span class="intro-line"></span>
    </div>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header brand="Portfolio" />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p class="footer-name">{profile.name}</p>
          {profile.email && <p>{obfuscateEmail(profile.email)}</p>}
        </div>
        <nav aria-label="フッターナビゲーション">
          <ul>
            <li><a href="/">ホーム</a></li>
            {pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
          </ul>
        </nav>
      </div>
      <div class="container">
        <small>© {new Date().getFullYear()} {profile.name}</small>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ── 開いたときの演出(幕が上がって本文が現れる) ── */
  .intro {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.intro-seen)) .intro {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: grid;
      place-content: center;
      justify-items: center;
      gap: 18px;
      background: var(--ink);
      color: var(--ink-text);
      animation: intro-out 0.8s var(--ease) 1.5s forwards;
    }
  }

  .intro-name {
    display: flex;
    overflow: hidden;
    font-family: var(--font-num);
    font-size: clamp(1.75rem, 1.2rem + 3vw, 3rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .intro-name span {
    display: inline-block;
    animation: intro-letter 0.6s var(--ease) both;
    animation-delay: calc(0.15s + var(--i) * 0.04s);
  }

  .intro-line {
    width: 0;
    height: 2px;
    background: var(--color-tertiary-light);
    animation: intro-line 0.9s var(--ease) 0.5s forwards;
  }

  @keyframes intro-letter {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }

  @keyframes intro-line {
    to {
      width: min(240px, 50vw);
    }
  }

  @keyframes intro-out {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }

  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--line);
    padding-block: 40px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .footer-name {
    color: var(--text);
    font-weight: 700;
  }

  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
</style>
