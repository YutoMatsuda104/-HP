---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { getProfile } from '../lib';

interface Props {
  /** ページ固有のタイトル(トップページでは省略) */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const profile = await getProfile();
const { title, description = profile.siteDescription, type = 'website' } = Astro.props;

const siteName = profile.nameEn ? `${profile.name} | ${profile.nameEn}` : profile.name;
const pageTitle = title ? `${title} | ${profile.name}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const isHome = Astro.url.pathname === '/';

const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name.replace(/\s+/g, ''),
      alternateName: profile.nameEn,
      url: Astro.site?.href,
      description: profile.siteDescription,
      affiliation: profile.affiliation,
    }
  : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header brand={profile.nameEn ?? profile.name} />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <small>© {new Date().getFullYear()} {profile.name}</small>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 32px 40px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
</style>
